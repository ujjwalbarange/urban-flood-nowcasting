# ============================================================
# Urban Flood Nowcasting System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values. Never commit .env.
# Credentials must be rotated if they were ever committed or shared.

# ---- Data providers ----
# Required only when downloading a fresh clipped terrain baseline.
OPENTOPOGRAPHY_API_KEY=

# NASA Earthdata authentication for IMERG downloads. Use one supported local
# method; do not set or commit passwords/tokens in source control.
NASA_EARTHDATA_TOKEN=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# MOSDAC adapter remains disabled until a product identifier and documented
# retrieval method are supplied. Do not invent an endpoint or credentials.
MOSDAC_API_URL=
MOSDAC_TOKEN=

# ---- Database (PostgreSQL + PostGIS) ----
POSTGRES_USER=ufn_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=urban_flood
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# ---- Public alternative rainfall provider ----
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ---- Object storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
# STORAGE_BACKEND=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Geospatial provenance ----
# Store source rasters and manifests below this directory. Do not overwrite
# candidate packages; each accepted artifact gets a SHA-256.
GEOSPATIAL_INGESTION_PATH=./data/storage/geospatial
